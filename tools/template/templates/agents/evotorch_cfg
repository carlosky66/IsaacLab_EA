seed: 42
generations: 100

# Problem
problem: "neproblem"

## NEProblem
neproblem:
  objective_sense: "max"
  network_expression: "Linear({obs_dim}, 256) >> ELU() >> Linear(256, 128) >> ELU() >> Linear(128, {act_dim}) >> Tanh()"
  initial_bounds: [-0.1, 0.1]
  network_args:  null
  eval_dtype:  null
  eval_data_length: 0
  num_actors:  null
  actor_config:  null
  num_gpus_per_actor:  null
  num_subbatches:  null
  subbatch_size: null

algorithm: "pgpe"

# CEM

cem:
  parenthood_ratio: 0.1
  stdev_init: 0.1
  radius_init: null
  num_interactions: null
  popsize_max: null
  center_init: null
  stdev_min: null
  stdev_max: null
  stdev_max_change: null
  obj_index: null
  distributed: false
  popsize_weighted_grad_avg: null

# CMA-ES

cmaes:
  stdev_init: 0.1
  popsize: 4096
  center_init: null
  c_m: 1.0
  c_sigma: null
  c_sigma_ratio: 1.0
  damp_sigma: null
  damp_sigma_ratio: 1.0
  c_c: null
  c_c_ratio: 1.0
  c_1: null
  c_1_ratio: 1.0
  c_mu: null
  c_mu_ratio: 1.0
  active: true
  csa_squared: false
  stdev_min: null
  stdev_max: null
  separable: true
  limit_C_decomposition: true
  obj_index: null

# Cosyne

cosyne:
  tournament_size: 4
  mutation_stdev: 0.1
  mutation_probability: null
  permute_all: false
  num_elites: null
  elitism_ratio: 0.1
  eta: null
  num_children: null

# Genetic Algorithm

ga:
  operators: 
    crossover:
      name: "TWOPOINT"
      args:
        tournament_size: 4
        obj_index: null
        num_children: null
        cross_over_rate: null
      
    mutation:
      name: "Gaussian"
      args:
        stdev: 0.1
        mutation_probability: 0.2
  elitist: true
  re_evaluate: true
  re_evaluate_parents_first: null

# PGPE

pgpe:
  center_learning_rate: 0.05
  stdev_learning_rate: 0.1
  stdev_init: 0.1
  radius_init: null
  num_interactions: null
  popsize_max: null
  optimizer: "clipup"
  optimizer_config: null
  ranking_method: "centered"
  center_init: null
  stdev_min: null
  stdev_max: null
  stdev_max_change: 0.2
  symmetric: true
  obj_index: null
  distributed: false

# SNES

snes:
  stdev_init: 0.1
  radius_init: null
  popsize: null
  center_learning_rate: null
  stdev_learning_rate: null
  scale_learning_rate: true
  num_interactions: null
  popsize_max: null
  optimizer: null
  optimizer_config: null
  ranking_method: 'nes'
  center_init: null
  stdev_min: null
  stdev_max: null
  stdev_max_change: null
  obj_index: null
  distributed: false
  popsize_weighted_grad_avg: null

# XNES

xnes:
  stdev_init: 0.1
  radius_init: null
  popsize: null
  center_learning_rate: null
  stdev_learning_rate: null
  scale_learning_rate: true
  num_interactions: null
  popsize_max: null
  num_interactions: null
  optimizer: null
  optimizer_config: null
  ranking_method: 'nes'
  center_init: null
  obj_index: null
  distributed: false
  popsize_weighted_grad_avg: null

experiment:
